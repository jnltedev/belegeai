# Copy to .env and fill in real values before running docker compose.

# --- Public URL ---
# There is only one public-facing service: the frontend. It proxies every
# /api/* request server-side to the backend (never exposed publicly) - see
# frontend/src/app/api/[...path]/route.ts. A reverse proxy/tunnel only ever
# needs to point at this one container/port.
PUBLIC_APP_URL=http://localhost:3005
# Set true only once TLS is actually terminated in front of this app (own
# reverse proxy/tunnel/VPN).
COOKIE_SECURE=false
# Always "lax" for this single-origin setup. "none" only exists for a
# (discouraged) split-origin deployment, and requires COOKIE_SECURE=true -
# the app refuses to start with none+insecure, since browsers silently drop
# that combination anyway.
COOKIE_SAME_SITE=lax

# --- Auth ---
AUTH_MODE=local
SESSION_SECRET=changeme-generate-a-long-random-secret-min-32-chars
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Secrets (each: `openssl rand -hex 32`) ---
# Encrypts settings stored in the DB that must be reversible (currently just
# the IMAP mailbox password - unlike user passwords/API keys, which are only
# ever hashed one-way). Losing/rotating this makes any already-saved IMAP
# password unreadable - you'd need to re-enter it.
SETTINGS_ENCRYPTION_KEY=changeme-64-hex-chars-generate-with-openssl-rand-hex-32
# Shared secret the ingest-worker container presents to authenticate its own
# internal ingestion endpoint (distinct from user-issued API keys).
INTERNAL_INGEST_SECRET=changeme-generate-a-long-random-secret-min-32-chars

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-change-me

# --- Backend ---
MAX_UPLOAD_MB=25

# --- Container images ---
# Which Docker Hub account the images are pulled from. Must match the
# DOCKERHUB_USERNAME secret used by .github/workflows/docker-publish.yml.
# Only relevant when running published images; building from source with
# docker-compose.build.yml ignores this.
IMAGE_NAMESPACE=jnltedev
# "latest" tracks the main branch. Pin to a release (e.g. 1.0.0) to control
# when a deployment moves.
IMAGE_TAG=latest

# --- Host ports ---
# FRONTEND_PORT is published on all interfaces (reachable from the LAN, and
# whatever your reverse proxy/tunnel points at) - it's the only one that
# needs to be. BACKEND_PORT, POSTGRES_PORT, and the MINIO_* ports are always
# bound to 127.0.0.1 only, regardless of these values, for host-local admin
# access (curl, psql, mc, isolated-stack testing) - never exposed to the
# network.
FRONTEND_PORT=3005
BACKEND_PORT=4001
POSTGRES_PORT=5432
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# --- AI extraction (optional; omit to keep uploads fully manual) ---
# One naming scheme for every provider, so switching means changing the
# provider and the key - nothing else.
#
#   gemini     Google Gemini. Default models: gemini-flash-latest,
#              gemini-embedding-001
#   openai     OpenAI. Default models: gpt-4.1, text-embedding-3-small
#   anthropic  Anthropic Claude. Default model: claude-opus-5.
#              Anthropic publishes no embedding endpoint, so the chat's
#              semantic search stays off and it answers from full-text and
#              trigram retrieval instead. Everything else works unchanged.
#   ollama     A local model on a server of your own. Nothing leaves your
#              network. Needs AI_BASE_URL instead of a key, see below.
AI_PROVIDER=gemini
AI_API_KEY=
# Leave empty to use the provider's default model shown above.
AI_MODEL=
AI_EMBEDDING_MODEL=

# --- Local model via Ollama (only for AI_PROVIDER=ollama) ---
# Address of your Ollama server. It is deliberately not part of this compose
# stack: a model wants a GPU or a lot of memory, which does not belong on the
# same machine as the archive.
# AI_BASE_URL=http://llm.example.lan:11434
#
# Pull both models on that server before switching over:
#   ollama pull qwen3-vl:8b        (default, reads images)
#   ollama pull nomic-embed-text   (default, powers semantic search)
#
# The embedding model has to output exactly 768 numbers, which is what this
# archive stores. nomic-embed-text does; mxbai-embed-large (1024) does not,
# and semantic search then stays off with a note in the log.
#
# Two things to know before switching:
#   - Ollama cannot read a PDF. A PDF is passed to the model as its embedded
#     text layer, so anything digitally produced works. A SCAN has no text
#     layer, and neither do the PDFs the iOS app builds from camera images:
#     those are filed for manual entry with no suggestion. A receipt
#     uploaded as a photo (jpg/png) does work, since that goes to the model
#     as an image.
#   - Uploads no longer wait for the result. The document is filed straight
#     into the review queue and analysed in the background, because a local
#     model takes minutes per document.
#
# Ollama has no authentication of its own. Keep the server on a private
# network, or put it behind a reverse proxy that wants a bearer token and
# then set that token as AI_API_KEY above.

# --- Branding (optional) ---
# Either a bare filename of a .png/.svg you dropped into ./branding/ (e.g.
# "logo.svg"), or a full https:// link to a logo hosted elsewhere - both
# work. Applies to the sidebar, login/register screens, browser favicon, and
# the chat assistant's icon. Leave blank for the default logo. Restart the
# frontend container after changing this.
LOGO_FILENAME=

# --- Push notifications for the iOS app (optional) ---
# No APNs key belongs here. Apple only accepts pushes signed with one, so
# they are relayed instead - by default through the relay this project runs,
# which needs no configuration at all.
#
# Set this only to point at a relay you run yourself:
# APNS_PUSH_PROXY_URL=https://push.example.com
#
# Either way the instance is connected once, as an admin, under
# Administration -> Push notifications. The instance token is stored
# encrypted in the database, not in this file.

# --- Language (optional) ---
# Default UI language for logged-out pages and any user who hasn't picked one
# yet via the navbar language menu. "de" or "en".
DEFAULT_LANGUAGE=de
